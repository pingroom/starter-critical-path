# Demo, tests, and graph need no credentials. Use connect or set BOTH values.
# Partial/blank values fail; keep credentials private.
# PINGROOM_TOKEN=your-robot-credential
# PINGROOM_ROOM=ROOMCODE1234
# Paths resolve from this project: plan.json, config.json,
# .pingroom/credentials.json, .planning/state.json, .planning/report.json
